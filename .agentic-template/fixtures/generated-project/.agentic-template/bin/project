#!/usr/bin/env python3
"""Minimal project facade for the generated-project fixture.

Dispatches context subcommands to the scaffolded context bin. A real generated
project would have a full project dispatcher; this fixture only needs context.
"""
import subprocess
import sys
from pathlib import Path

BIN = Path(__file__).resolve().parent
CONTEXT = BIN / "context"

if len(sys.argv) > 1 and sys.argv[1] == "context":
    result = subprocess.run([str(CONTEXT)] + sys.argv[2:])
    sys.exit(result.returncode)

print("project: only 'context' is available in this fixture")
sys.exit(1)
