#!/usr/bin/env python3
"""Run the portable context router test suite. Internal; use `project context test`.

Self-contained: resolves the repo root from this script's own location, puts
the library on sys.path, and runs unittest discover. No PYTHONPATH needed.
"""
import subprocess
import sys
from pathlib import Path

# Resolve repo root from this script's location:
# .agentic-template/bin/context-test -> .agentic-template/bin -> .agentic-template -> repo root
ROOT = Path(__file__).resolve().parents[2]
TESTS = ROOT / ".agentic-template" / "tests"
LIB = ROOT / ".agentic-template" / "lib"

if __name__ == "__main__":
    if not TESTS.is_dir():
        print("ERROR")
        print()
        print(f"no test directory at {TESTS}")
        sys.exit(2)
    env = dict(__import__("os").environ)
    # Put lib on PYTHONPATH so test modules can import toon, router, etc.
    existing = env.get("PYTHONPATH", "")
    env["PYTHONPATH"] = f"{LIB}:{existing}" if existing else str(LIB)
    sys.exit(
        subprocess.run(
            [sys.executable, "-m", "unittest", "discover", "-s", str(TESTS), "-t", str(TESTS)],
            env=env,
        ).returncode
    )
