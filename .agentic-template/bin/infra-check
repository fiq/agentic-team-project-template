#!/usr/bin/env python3
"""Infrastructure-as-code formatting and static validation.

Checks for the presence of IaC tooling and runs formatting and static
validation where available. Does not require cloud credentials. Does not
apply infrastructure.
"""
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path.cwd()


def fail(msg):
    print("INFRA CHECK FAILED")
    print()
    print(msg)
    return 1


def has_iac_files():
    indicators = [
        "*.tf",
        "*.tf.json",
        "Pulumi.yaml",
        "terragrunt.hcl",
    ]
    for pattern in indicators:
        if list(ROOT.glob(pattern)):
            return True
    return False


def has_k8s_files():
    if list(ROOT.glob("kustomization.yaml")) or list(ROOT.glob("kustomization.yml")):
        return True
    for base in ("k8s", "deploy", "manifests"):
        directory = ROOT / base
        if directory.is_dir() and (
            list(directory.rglob("*.yaml")) or list(directory.rglob("*.yml"))
        ):
            return True
    return False


def check_terraform():
    fmt = shutil.which("terraform")
    if not fmt:
        return fail("terraform not found on PATH")

    fmt_check = subprocess.run(
        [fmt, "fmt", "-check", "-recursive"],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        cwd=str(ROOT),
    )
    if fmt_check.returncode != 0:
        return fail(f"terraform fmt check failed:\n{fmt_check.stdout.strip()}")

    validate = subprocess.run(
        [fmt, "init", "-backend=false"],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        cwd=str(ROOT),
    )
    if validate.returncode != 0:
        return fail(f"terraform init failed:\n{validate.stdout.strip()}")

    validate = subprocess.run(
        [fmt, "validate"],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        cwd=str(ROOT),
    )
    if validate.returncode != 0:
        return fail(f"terraform validate failed:\n{validate.stdout.strip()}")

    return 0


def check_pulumi():
    pul = shutil.which("pulumi")
    if not pul:
        return fail("pulumi not found on PATH")

    # Pulumi preview with a local backend does not require cloud credentials.
    # Projects using a cloud backend (S3, Azure, GCP, etc.) must provide
    # credentials out-of-band; this check does not inject secrets.
    result = subprocess.run(
        [pul, "preview", "--diff", "--non-interactive"],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        cwd=str(ROOT),
    )
    if result.returncode != 0:
        return fail(f"pulumi preview failed:\n{result.stdout.strip()}")

    return 0


def find_kustomization_dir():
    """Return the directory containing a kustomization file, or None.

    Checked at the repo root and inside the conventional manifest
    directories, matching the scope of `has_k8s_files()`.
    """
    for name in ("kustomization.yaml", "kustomization.yml"):
        if (ROOT / name).exists():
            return ROOT
    for base in ("k8s", "deploy", "manifests"):
        directory = ROOT / base
        if not directory.is_dir():
            continue
        for name in ("kustomization.yaml", "kustomization.yml"):
            if (directory / name).exists():
                return directory
    return None


def check_kubernetes():
    tool = shutil.which("kubeconform")
    if not tool:
        return fail("kubernetes manifests present but kubeconform not found on PATH")

    kustomize_dir = find_kustomization_dir()
    if kustomize_dir is not None:
        # Real kustomize overlays are strategic-merge patches that omit
        # required fields (e.g. a Deployment image patch omitting
        # spec.selector). Validate the rendered output, not the raw
        # kustomize source directory.
        kustomize = shutil.which("kustomize")
        if not kustomize:
            return fail(
                "kustomize not found on PATH (required to render "
                "kustomization.yaml before validation)"
            )

        target = "." if kustomize_dir == ROOT else str(kustomize_dir.relative_to(ROOT))
        render = subprocess.run(
            [kustomize, "build", target],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            cwd=str(ROOT),
        )
        if render.returncode != 0:
            return fail(f"kustomize build failed:\n{render.stdout.strip()}")

        # kubeconform reads a YAML stream from stdin when no file/directory
        # arguments are given; -recursive only applies to on-disk targets.
        result = subprocess.run(
            [tool, "-strict", "-summary", "-ignore-missing-schemas"],
            input=render.stdout,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            cwd=str(ROOT),
        )
        if result.returncode != 0:
            return fail(f"kubeconform validation failed:\n{result.stdout.strip()}")

        return 0

    # No kustomization file: plain manifest directories, validated directly.
    targets = [base for base in ("k8s", "deploy", "manifests") if (ROOT / base).is_dir()]
    if not targets:
        return fail("kubernetes manifests present but no validation targets found")

    result = subprocess.run(
        [tool, "-strict", "-summary", "-ignore-missing-schemas", "-recursive", *targets],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        cwd=str(ROOT),
    )
    if result.returncode != 0:
        return fail(f"kubeconform validation failed:\n{result.stdout.strip()}")

    return 0


def main():
    iac = has_iac_files()
    k8s = has_k8s_files()

    if not iac and not k8s:
        print("INFRA CHECK: no IaC files found")
        print("status: not_applicable")
        return 0

    passed = []

    if iac:
        # Prefer terraform when present.
        if shutil.which("terraform"):
            result = check_terraform()
            label = "terraform"
        elif shutil.which("pulumi"):
            result = check_pulumi()
            label = "pulumi"
        else:
            return fail("IaC files present but no supported tool found on PATH")
        if result != 0:
            return result
        passed.append(label)

    if k8s:
        result = check_kubernetes()
        if result != 0:
            return result
        passed.append("kubeconform")

    print(f"INFRA CHECK OK ({', '.join(passed)})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
