#!/usr/bin/env python3
"""Opt-in git hook installer.

Installs a pre-commit hook that runs `project hooks`, which executes the
checks declared in `.agents/hooks.toon` concurrently. Never installed
automatically; run `.agentic-template/bin/project install-hooks` to opt in.

Which checks run, and whether each one blocks a commit, is decided by
`.agents/hooks.toon` rather than by this installer. Editing that file takes
effect immediately — there is no need to reinstall the hook after changing
it, or after `/specialise` wires up `project lint`.

An existing pre-commit hook that this installer did not write is left alone.
"""
from pathlib import Path
import subprocess
import sys

ROOT = Path.cwd()
MARKER = "install-hooks"

HOOK = """#!/bin/sh
# Installed by: .agentic-template/bin/project install-hooks
# Checks are declared in .agents/hooks.toon, not here. Edit that file to add,
# remove or unblock a check; this hook needs no reinstall.
exec .agentic-template/bin/project hooks
"""


def git_dir():
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--git-dir"],
            cwd=str(ROOT),
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except OSError:
        return None
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return (ROOT / result.stdout.strip()).resolve()


def main():
    gd = git_dir()
    if gd is None:
        print("install-hooks: not a git repository; nothing to install")
        return 1
    if not (ROOT / ".agents/hooks.toon").exists():
        print("install-hooks: .agents/hooks.toon is missing; nothing to run")
        return 1
    hooks = gd / "hooks"
    hooks.mkdir(parents=True, exist_ok=True)
    pre_commit = hooks / "pre-commit"
    if pre_commit.exists() and MARKER not in pre_commit.read_text():
        print(f"install-hooks: {pre_commit} already exists and is not ours; leaving it")
        return 1
    pre_commit.write_text(HOOK)
    pre_commit.chmod(0o755)
    print(f"install-hooks: installed pre-commit at {pre_commit}")
    print("             checks are declared in .agents/hooks.toon")
    print("             run them any time with: .agentic-template/bin/project hooks")
    return 0


if __name__ == "__main__":
    sys.exit(main())
