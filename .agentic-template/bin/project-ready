#!/usr/bin/env python3
"""Deterministic readiness check.

Runs all applicable deterministic checks and prints a clear
PASS / NOT APPLICABLE / FAIL summary.

A skipped unresolved decision is FAIL, not NOT APPLICABLE.
"""
import importlib.machinery
import importlib.util
from pathlib import Path
import subprocess
import sys

ROOT = Path.cwd()
BIN = Path(__file__).resolve().parent
COMMAND_NAME = ".agentic-template/bin/project"


def _load_project_dispatcher():
    """Import the `project` dispatcher module to read its UNSPECIALISED set.

    `project --list` cannot be used for this: it always prints the union of
    COMMANDS and UNSPECIALISED (every command name appears either way), so it
    cannot distinguish a specialised command from one that still fails
    clearly with "harness not specialised".
    """
    loader = importlib.machinery.SourceFileLoader("_project_dispatcher", str(BIN / "project"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# Runtime commands in shift-left order: static analysis gates the build, the
# build gates the tests. Kept as data so the selection logic below stays
# directly testable without running the whole readiness suite.
RUNTIME_COMMANDS = (
    ("lint", "lint"),
    ("build", "build"),
    ("test", "unit tests"),
    ("integration-test", "integration tests"),
    ("contract-test", "contract tests"),
)


def select_runtime_commands(is_template, unspecialised):
    """Return the (command, label) pairs `ready` should run for this project.

    A command is run only once /specialise has actually moved it out of the
    dispatcher's UNSPECIALISED set. Template state runs none of them.
    """
    if is_template:
        return []
    return [
        (command, label)
        for command, label in RUNTIME_COMMANDS
        if command not in unspecialised
    ]


def read_profile():
    profile = ROOT / "PROJECT_PROFILE.toon"
    if not profile.exists():
        return ""
    return profile.read_text()


def has_docker():
    result = subprocess.run(
        ["sh", "-c", "command -v docker >/dev/null 2>&1"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def has_compose_file():
    compose = ROOT / "compose.yaml"
    if not compose.exists():
        return False
    try:
        text = compose.read_text()
    except OSError:
        return False
    # Empty compose file has "services: {}" (with or without spaces).
    normalised = text.replace(" ", "")
    return "services:{}" not in normalised


def has_dockerfile():
    return (ROOT / "Dockerfile").exists() or (ROOT / "Containerfile").exists()


def run(cmd, label):
    result = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    return label, result


def main():
    profile = read_profile()
    is_template = "state: template" in profile
    docker_available = has_docker()
    compose_present = has_compose_file()
    dockerfile_present = has_dockerfile()

    # Always-applicable checks.
    steps = [
        (["sh", "-c", "git diff --check"], "git diff --check"),
        ([str(BIN / "check-repo-contract")], "repository contract"),
        ([str(BIN / "check-project-profile")], "project profile"),
        ([str(BIN / "check-handoff")], "handoff"),
        ([str(BIN / "check-knowledge")], "knowledge"),
        ([str(BIN / "check-changes")], "change specs"),
        ([str(BIN / "check-wiki")], "wiki upkeep"),
        ([str(BIN / "check-readme")], "documentation"),
    ]

    # Lint and build are unspecialised in template state; only run them once
    # /specialise has actually moved them out of UNSPECIALISED. Order matches
    # the shift-left contract: lint, then build, then test.
    project_script = str(BIN / "project")
    unspecialised = _load_project_dispatcher().UNSPECIALISED

    for command, label in select_runtime_commands(is_template, unspecialised):
        steps.append(([project_script, command], label))

    # Container checks.
    if is_template:
        pass
    elif dockerfile_present and docker_available:
        if "image-test" not in unspecialised:
            steps.append(([project_script, "image-test"], "container image test"))
        else:
            steps.append(([project_script, "image"], "container image build"))
    elif dockerfile_present and not docker_available:
        steps.append(None)  # placeholder handled below

    # Compose checks.
    if not is_template and compose_present and docker_available:
        steps.append(([project_script, "compose-config"], "compose config"))
        if "compose-test" not in unspecialised:
            steps.append(([project_script, "compose-test"], "compose test"))

    # Infra checks.
    if not is_template and "infra-check" not in unspecialised:
        steps.append(([project_script, "infra-check"], "infra check"))

    passed = []
    failed = []
    not_applicable = []

    for step in steps:
        if step is None:
            not_applicable.append(
                ("container image test", "docker runtime unavailable")
            )
            continue
        cmd, label = step
        result = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
        if result.returncode == 0:
            passed.append(label)
        else:
            print(f"--- {label} ---")
            print(result.stdout.strip())
            print()
            failed.append((label, result.returncode))

    # Not-applicable determinations.
    if is_template:
        not_applicable.append(("container image", "template state: no application image"))
        not_applicable.append(("compose test", "template state: empty compose"))
        not_applicable.append(("infra check", "template state: no deployment target"))

    if not is_template and not dockerfile_present:
        container_state = containers_resolved(profile)
        if container_state == "not_applicable":
            not_applicable.append(
                ("container image", "containerisation recorded as not_applicable")
            )
        elif container_state == "unknown":
            failed.append(
                ("container decision", "container decision is unknown, not not_applicable")
            )
        else:
            not_applicable.append(("container image", "no Dockerfile; container decision recorded"))

    if not is_template and not compose_present:
        not_applicable.append(("compose test", "compose topology empty by project decision"))

    if not is_template and not docker_available and not compose_present and not dockerfile_present:
        pass

    print("SUMMARY")
    print()
    print(f"PASS             {len(passed)}")
    print(f"NOT APPLICABLE   {len(not_applicable)}")
    print(f"FAIL             {len(failed)}")
    print()
    if passed:
        print("PASSED")
        for label in passed:
            print(f"  - {label}")
        print()
    if not_applicable:
        print("NOT APPLICABLE")
        for label, reason in not_applicable:
            print(f"  - {label}: {reason}")
        print()
    if failed:
        print("FAILED")
        for label, _code in failed:
            print(f"  - {label}")
        print()
        print("READY: FAIL")
        return 1

    print("READY: PASS")
    return 0


def containers_resolved(profile_text):
    """Return 'built', 'not_applicable', or 'unknown'."""
    if "application_image: built" in profile_text:
        return "built"
    if "application_image: not_applicable" in profile_text:
        return "not_applicable"
    return "unknown"


if __name__ == "__main__":
    sys.exit(main())
