#!/usr/bin/env python3
"""Scan tracked files for credential-shaped values.

This is a deterministic shift-left gate: it catches API keys, tokens and
private keys before they reach review or a public repository. It is not a
substitute for a full secret scanner (e.g. gitleaks, trufflehog) but it
covers the common shapes with zero dependencies and no network access.

Deliberately skipped:
- lockfiles (flake.lock) — pinned hashes can look like tokens;
- the qualification fixture — it contains deliberate non-secret test tokens;
- binary files and .git internals.
"""
import re
import sys
from pathlib import Path

ROOT = Path.cwd()

# Credential-shaped values. Keep the list conservative to avoid false
# positives on code identifiers and documentation.
PATTERNS = [
    (re.compile(r"\bsk-[A-Za-z0-9]{20,}\b"), "OpenAI-style API key"),
    (re.compile(r"\bghp_[A-Za-z0-9]{30,}\b"), "GitHub personal access token"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "AWS access key id"),
    (re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{20,}\b"), "Slack token"),
    (re.compile(r"\bAIza[0-9A-Za-z_-]{30,}\b"), "Google API key"),
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"), "private key block"),
]

# Paths that legitimately contain token-like text.
SKIP_PREFIXES = (
    ".git/",
    "__pycache__/",
    ".agentic-template/fixtures/qualification-repo/",
    ".agents/context/qualification/",
    # The check-secrets test file deliberately plants fake secrets to prove
    # the detector works; it must not trip the check on a clean repo.
    ".agentic-template/tests/test_static_analysis.py",
)
SKIP_SUFFIXES = (".lock", ".png", ".jpg", ".jpeg", ".gif", ".ico", ".woff", ".woff2")


def iter_text_files(root):
    for path in sorted(root.rglob("*")):
        if not path.is_file():
            continue
        relative = str(path.relative_to(root))
        if any(relative.startswith(prefix) for prefix in SKIP_PREFIXES):
            continue
        if "__pycache__" in path.parts:
            continue
        if any(relative.endswith(suffix) for suffix in SKIP_SUFFIXES):
            continue
        yield relative, path


def main():
    findings = []
    for relative, path in iter_text_files(ROOT):
        try:
            text = path.read_text(errors="ignore")
        except (OSError, UnicodeDecodeError):
            continue
        for pattern, label in PATTERNS:
            if pattern.search(text):
                findings.append(f"{relative}: possible {label}")
    if findings:
        print("SECRETS CHECK FAILED")
        print()
        for finding in findings:
            print(f"- {finding}")
        print()
        print("Remove the credential or move it to an untracked .env file.")
        return 1
    print("SECRETS CHECK OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
