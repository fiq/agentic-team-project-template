#!/usr/bin/env python3
"""Dependency vulnerability audit via osv-scanner.

Runs osv-scanner over the repository's dependency manifests using a
repeatable execution ladder: a tool provided by the Nix devshell first,
then a pinned official container, then an explicit skip. Skipping is never
a silent pass: it prints a visible WARNING and records the skip reason.

A non-zero exit from the wrapped tool is not automatically "vulnerabilities
found": a docker invocation that returns 125 means docker itself could not
run the container (daemon unavailable, image pull failed, etc.), and output
containing a common network-failure substring means osv-scanner could not
reach the OSV database. Both are classified as a skip, not a failure. Any
other non-zero exit is a real result (vulnerabilities, or a genuine tool
error) and is reported as DEP AUDIT FAILED.

Requires network access to reach the OSV database. Does not modify the
repository. Returns not_applicable (exit 0) when no dependency manifests
exist.
"""
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path.cwd()
OSV_IMAGE = "ghcr.io/google/osv-scanner:v1.9.2"

# `docker run` exits 125 when docker itself failed to start the container
# (daemon not running, image pull failed, etc.) — distinct from the wrapped
# tool running and reporting a real result.
DOCKER_CANNOT_RUN = 125

# Case-insensitive substrings in captured output that indicate the tool
# could not reach the network, rather than reporting a real scan result.
NETWORK_FAILURE_SUBSTRINGS = [
    "connection refused",
    "no such host",
    "could not resolve",
    "network is unreachable",
    "dial tcp",
    "timeout",
    "tls handshake",
]

MANIFEST_NAMES = [
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "requirements.txt",
    "poetry.lock",
    "Pipfile.lock",
    "Cargo.lock",
    "go.mod",
    "pom.xml",
    "build.gradle",
    "build.gradle.kts",
    "mix.exs",
    "Gemfile.lock",
    "composer.lock",
]


def has_manifests():
    for name in MANIFEST_NAMES:
        if list(ROOT.rglob(name)):
            return True
    return False


def fail(reason):
    print("DEP AUDIT FAILED")
    print()
    print(reason)
    return 1


def skip(reason):
    print("DEP AUDIT SKIPPED")
    print()
    print(f"WARNING: dependency audit skipped: {reason}")
    print("status: skipped")
    print("This is not a pass. Re-run with osv-scanner or docker available")
    print("and network access to obtain a real result.")
    return 0


def is_network_failure(output):
    lowered = output.lower()
    return any(substring in lowered for substring in NETWORK_FAILURE_SUBSTRINGS)


def run_native():
    result = subprocess.run(
        ["osv-scanner", "-r", "."],
        cwd=str(ROOT),
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    if result.returncode == 0:
        print("DEP AUDIT OK (osv-scanner)")
        return 0
    if is_network_failure(result.stdout):
        return skip("osv-scanner could not reach the network")
    return fail(f"osv-scanner reported findings or an error:\n{result.stdout.strip()}")


def run_container():
    result = subprocess.run(
        [
            "docker", "run", "--rm",
            "-v", f"{ROOT}:/src:ro",
            OSV_IMAGE, "-r", "/src",
        ],
        cwd=str(ROOT),
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    if result.returncode == 0:
        print(f"DEP AUDIT OK (osv-scanner container {OSV_IMAGE})")
        return 0
    if result.returncode == DOCKER_CANNOT_RUN:
        return skip("docker could not run osv-scanner (daemon unavailable?)")
    if is_network_failure(result.stdout):
        return skip("osv-scanner could not reach the network")
    return fail(f"osv-scanner reported findings or an error:\n{result.stdout.strip()}")


def main():
    if not has_manifests():
        print("DEP AUDIT: no dependency manifests found")
        print("status: not_applicable")
        return 0

    if shutil.which("osv-scanner"):
        return run_native()

    if shutil.which("docker"):
        return run_container()

    return skip("neither osv-scanner nor docker is available on PATH")


if __name__ == "__main__":
    sys.exit(main())
