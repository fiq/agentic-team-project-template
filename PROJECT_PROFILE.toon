project:
  state: template
  confidence: medium
  concept_date: 2026-05-16
  concept_date_reason: original decision date for creating this template

budget:
  appetite: unknown    # constrained | moderate | comfortable | generous
  influence_on_right_sizing: a constrained budget makes the smallest sufficient architecture mandatory and scope must be aggressively thin-sliced
  revisit_trigger: budget appetite changes or project scope changes

audience:
  skill_level: unknown
  app_shape: unknown
  language_by_role: []
  right_sizing:
    smallest_sufficient: template has no application architecture yet
    deliberately_excluded: []
    revisit_when:
      - project instantiated via /specialise
    bought_in: false

facts:
  - id: template_repository
    observation: repository is a reusable AI-first project template
    evidence:
      - AGENTS.md
      - CUSTOMIZE_THIS_PROJECT.toon
    confidence: high

inferences:
  - id: no_application_runtime_yet
    conclusion: template state intentionally has no Java, Python, Node, Elixir or Godot runtime
    based_on:
      - no_runtime_manifest_present
      - generic_nix_shell
    confidence: high
    validation: run .agentic-template/bin/inspect-project after customisation

decisions:
  - id: project_concept_date
    decision: record 2026-05-16 as the project concept date
    reason:
      - captures the date the project was decided
      - separates project intent metadata from implementation timestamps
    confidence: high
    status: active
    validation:
      - docs/decisions/0001-record-project-concept-date.md
    consequence_if_changed: project origin metadata becomes less clear
  - id: composable_skills
    decision: /specialise orchestrates lazy-loaded bounded skills
    reason:
      - reduces context size
      - avoids one monolithic prompt
    confidence: high
    status: active
    validation:
      - .agents/skills/CATALOG.toon
      - .agents/skills/init/SKILL.md
    consequence_if_changed: init workflow becomes harder to reason about
  - id: mit_template_license
    decision: include MIT license in template state
    reason:
      - permissive default for reusable template
      - /specialise must re-evaluate license fit
    confidence: medium
    status: active
    validation:
      - LICENSE
      - .agents/skills/init/SKILL.md
    consequence_if_changed: downstream projects may need a different license
  - id: truthful_git_provenance
    decision: use real commit author and committer dates
    reason:
      - avoids false project history
      - keeps repository provenance auditable
    confidence: high
    status: active
    validation:
      - AGENTS.md
    consequence_if_changed: history becomes misleading
  - id: canonical_project_script
    decision: use .agentic-template/bin/project as the stable repository command surface
    reason:
      - avoids colliding with downstream projects that already have a Makefile
      - keeps command dispatch testable with Python standard library
      - leaves runtime-specific build tools free for project specialisation
    confidence: high
    status: active
    validation:
      - .agentic-template/bin/project --list
      - .agentic-template/bin/project check
    consequence_if_changed: generated projects may inherit confusing or conflicting command wrappers
  - id: repository_local_knowledge_layer
    decision: use .agents/knowledge for durable knowledge, proposals and graph-like relationships
    reason:
      - preserves HANDOFF.toon as active task state
      - keeps Superpowers focused on engineering workflow
      - gives agents searchable local context without external infrastructure
    confidence: high
    status: active
    validation:
      - .agents/knowledge/README.md
      - .agentic-template/bin/check-knowledge
    consequence_if_changed: agents may duplicate guidance or lose durable learnings between sessions
  - id: repo_native_context_store
    decision: treat the repository as the context store for agents and humans
    reason:
      - keeps structure, lineage, behavior and conformance versioned with code
      - avoids adding external memory infrastructure before project evidence exists
      - gives fresh sessions deterministic artifacts to query before planning
    confidence: high
    status: active
    validation:
      - docs/context-store.md
      - .agentic-template/bin/project docs
      - .agentic-template/bin/project check
    consequence_if_changed: agents may depend on stale remembered context or ungoverned external stores
  - id: structured_data_policy_configurable
    decision: allow generated projects to choose TOON or S-expressions by semantic purpose
    reason:
      - TOON is readable and diff-friendly for state and contracts
      - S-expressions are compact and regular for rule predicates and computation
      - explicit policy prevents format drift across agent handoffs
    confidence: medium
    status: active
    validation:
      - docs/structured-data.md
      - .agentic-template/bin/check-project-profile
    consequence_if_changed: agents may mix semantic formats without a recorded reason
  - id: architecture_fitness_functions
    decision: generated projects identify top architecture risks and encode cheap deterministic fitness functions where practical
    reason:
      - moves repeated conformance checks out of ad hoc review memory
      - keeps AI-led changes aligned with architecture characteristics
      - makes handoffs explicit about constraint changes
    confidence: medium
    status: active
    validation:
      - docs/validation.md
      - docs/context-store.md
      - .agentic-template/bin/project ready
    consequence_if_changed: architecture drift remains dependent on reviewer recall
  - id: portable_context_router
    decision: route context depth and timing by profile, never required behaviour
    reason:
      - capable models lose reasoning to duplicated and contradictory guidance
      - unfamiliar runtimes and high-risk work still need explicit scaffolding
      - a template cannot know which model or runtime will read it
    confidence: medium
    status: active
    validation:
      - .agentic-template/bin/project context check
      - .agentic-template/bin/project context test
      - docs/wiki/method/context-router.md
    consequence_if_changed: context size becomes a fixed guess that is wrong for some readers
  - id: capability_by_observation_not_registry
    decision: license lean context from fixture-scored behaviour, never from model identity
    reason:
      - self-reported identity can be absent or wrong
      - the same model behaves differently across runtimes
      - a model registry is stale the week after it is written
    confidence: medium
    status: active
    validation:
      - .agents/context/qualification/QUALIFICATION.toon
      - .agentic-template/fixtures/qualification-repo
    consequence_if_changed: routing becomes a reputation judgement rather than evidence
  - id: wiki_method_product_axis
    decision: every wiki page declares axis method or product, matching its directory
    reason:
      - methodology is inherited from the template; product documentation is written by the project
      - generated-project users should not read template procedure beside their domain model
      - agents need to know which pages they rewrite after /specialise
    confidence: high
    status: active
    validation:
      - .agentic-template/bin/project context check
      - docs/wiki/index.md
    consequence_if_changed: generated wikis interleave inherited procedure with project knowledge
  - id: yaml_skill_frontmatter_deviation
    decision: keep skill frontmatter in YAML despite the TOON default for state
    reason:
      - native skill loaders in supported hosts parse YAML
      - the parsed subset is identical, so one parser serves both
    confidence: high
    status: active
    validation:
      - .agentic-template/lib/skills.py
    consequence_if_changed: skills stop loading natively in at least one supported runtime
  - id: static_analysis_from_specialise
    decision: every generated project makes an explicit static-analysis decision at /specialise
    reason:
      - shift-left: catch defects before tests and review
      - deterministic enforcement via project lint and CI
      - evolvable tool choices with deprecation revisit triggers
      - adaptable across runtimes: pick the right tools per language, pivot easily
    confidence: medium
    status: active
    validation:
      - .agents/skills/specialise/static-analysis/SKILL.md
      - .agentic-template/bin/project lint
    consequence_if_changed: static analysis may be omitted or ad hoc
  - id: nix_first_build_pipeline
    decision: every generated project makes an explicit build decision at /specialise; Nix owns the toolchain
    reason:
      - repeatability: same commit produces same artefact locally and in CI
      - Nix-first for developer tooling; container build for deployable artefacts
      - evolvable build targets (container, Lambda zip, static binary, etc.)
    confidence: medium
    status: active
    validation:
      - .agents/skills/specialise/build-pipeline/SKILL.md
      - .agentic-template/bin/project build
    consequence_if_changed: builds may be non-reproducible or ad hoc
  - id: deployment_pipeline_from_specialise
    decision: every generated project records a deployment pipeline decision at /specialise
    reason:
      - catered from the start, even when deferred
      - evolvable targets (container, Lambda, Fly, static, etc.)
      - promotion model recorded (automated, manual, deferred)
    confidence: medium
    status: active
    validation:
      - .agents/skills/specialise/deployment-pipeline/SKILL.md
    consequence_if_changed: deployment may be implicit or ad hoc
  - id: observability_from_specialise
    decision: every generated project records an observability decision at /specialise
    reason:
      - design for prod from the start, not bolted on
      - OTel traces, structured logs, metrics with correlation IDs
      - local instrumentation that works in dev and CI
    confidence: medium
    status: active
    validation:
      - .agents/skills/specialise/observability/SKILL.md
    consequence_if_changed: observability may be omitted or prod-only

unknowns:
  - id: target_project_domain
    question: What domain and users will a generated project serve?
    why_it_matters:
      - affects architecture recommendation
      - affects test harness risks
      - affects persistence and integration choices
    evidence: []
    working_assumption: unknown_until_template_instantiated
    consequence_if_wrong: /specialise may recommend the wrong thin slice
    blocking: false
    validation:
      - inspect CUSTOMIZE_THIS_PROJECT.toon
      - inspect repository evidence
      - ask smallest useful question set
    status: open
  - id: application_runtime
    question: Which runtime and framework does the instantiated project need?
    why_it_matters:
      - determines dev shell extensions
      - determines test harness
      - determines build container strategy
    evidence: []
    working_assumption: infer_from_repository_evidence
    consequence_if_wrong: build and test commands may be specialised incorrectly
    blocking: false
    validation:
      - .agentic-template/bin/inspect-project
      - discovery runtime skills
    status: open

rejected_options:
  - id: monolithic_init_prompt
    option: put all runtime and infrastructure instructions into /specialise
    reason_rejected:
      - wastes context
      - makes project intelligence harder to evolve
    evidence:
      - .agents/skills/CATALOG.toon
  - id: default_platform_stack
    option: include Kafka, Redis, database, Kubernetes or LocalStack by default
    reason_rejected:
      - no template-state evidence justifies them
      - increases decision fatigue
    evidence:
      - compose.yaml
  - id: template_makefile_facade
    option: keep a template Makefile as the canonical command facade
    reason_rejected:
      - can conflict with legitimate downstream project Makefiles
      - Make target hierarchies can hide behaviour and confuse agents
      - .agentic-template/bin/project is explicit and directly testable
    evidence:
      - .agentic-template/bin/project
  - id: model_capability_registry
    option: maintain a table of models and their context capabilities
    reason_rejected:
      - stale within weeks of being written
      - self-reported identity is unreliable
      - the same model differs by runtime
    evidence:
      - .agents/context/qualification/QUALIFICATION.toon
  - id: host_auto_memory_for_project_facts
    option: rely on host-managed automatic memory instead of repository state
    reason_rejected:
      - not portable across Claude Code, Codex, OpenCode and Roo
      - unversioned, unreviewable and invisible to CI
      - becomes a second source of truth beside the repo-native context store
    evidence:
      - docs/context-store.md

architecture:
  application_shape: unknown
  language: unknown
  framework: unknown
  build_system: unknown
  integrations:
    messaging: none_known
    external_services: []
  persistence:
    kind: unknown
    provider: unknown

testing:
  harness: unspecialised
  layers: []
  test_first: true
  philosophy: testing_trophy

structured_data:
  control_files:
    format: toon
    reason: template bootstrap tools read PROJECT_PROFILE.toon, HANDOFF.toon and CUSTOMIZE_THIS_PROJECT.toon
  state_and_contracts:
    format: toon
    allowed:
      - toon
      - s_expression
    default_reason: best default for human-readable state, line diffs and docs-adjacent contracts
  rules_and_compute:
    format: s_expression
    allowed:
      - toon
      - s_expression
      - none
    default_reason: best default for compact predicates, routing rules and executable policy DSLs when needed
  mixed_use_allowed: true
  rule: use one semantic format per artifact; record deviations as decisions

containers:
  application_image: not_applicable
  reason: template repository has no deployable application runtime
  image_test: not_applicable
  compose: minimal_template

infrastructure:
  local_topology: nix
  deployment_target: unknown
  iac:
    status: deferred
    tool: null
    validation_command: null
    revisit_trigger: deployment target selected during project instantiation

tooling:
  superpowers:
    status: detect
  mcp:
    required: []
    optional: []
  context_budget:
    default_target: small
    reserve_response_percent: 30
    packet_style: semantic_summary_with_source_refs
    source_refs_required: true
    opaque_transport_blobs: false
  context_store:
    default: repository_native
    external_store: not_default
    layers:
      - structure
      - lineage
      - behavior
      - conformance
    guide: docs/context-store.md
    validator: .agentic-template/bin/project check
  context_router:
    scaffold_version: 1
    profiles: [lean, standard, guarded]
    default_on_uncertainty: standard
    qualification: fixture_scored
    observations: gitignored_in_template
    guide: docs/wiki/method/context-router.md
    config: .agents/context/README.md
    validator: .agentic-template/bin/project context check
  knowledge:
    location: .agents/knowledge
    validator: .agentic-template/bin/check-knowledge
    promotion: inbox_then_review
